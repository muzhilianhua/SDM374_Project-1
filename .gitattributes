# Frozen v3.3 source and release hashes must survive Windows checkouts.
analysis/v33_protocol/*.py text eol=lf
analysis/v33_protocol/release_v1/*.py text eol=lf
analysis/v33_protocol/release_v1/*.json text eol=lf
analysis/v33_protocol/release_v1/*.csv text eol=lf
analysis/v33_protocol/release_v2/*.py text eol=lf
analysis/v33_protocol/release_v2/*.json text eol=lf
analysis/v33_protocol/release_v2/*.csv text eol=lf
# Freeze exact release/evidence bytes, including CSV CRLF and JSON LF, on every platform.
analysis/v33_protocol/** -text whitespace=cr-at-eol
# Course-provided solver files: keep their original bytes (run.py has CRLF).
solver/** -text

# Course-computer kit: cmd.exe needs CRLF in batch files.
deploy/course-pc/bat/*.bat text eol=crlf
