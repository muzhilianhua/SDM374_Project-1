# Frozen v3.3 source and release hashes must survive Windows checkouts.
analysis/v33_protocol/*.py text eol=lf
analysis/v33_protocol/release_v1/*.py text eol=lf
analysis/v33_protocol/release_v1/*.json text eol=lf
analysis/v33_protocol/release_v1/*.csv text eol=lf
analysis/v33_protocol/release_v2/*.py text eol=lf
analysis/v33_protocol/release_v2/*.json text eol=lf
analysis/v33_protocol/release_v2/*.csv text eol=lf
# Freeze exact release/evidence bytes, including CSV CRLF and JSON LF, on every platform.
analysis/v33_protocol/** -text whitespace=cr-at-eol
# Course-provided solver files: keep their original bytes (run.py has CRLF).
solver/** -text
# Online validation run: config.json pins the train.csv and solver sha256 values, and
# output_manifest.json pins every generated artefact, so checkouts must not rewrite line endings.
analysis/online_validation_105/** -text
# Online surrogate packages pin their exact bytes in CHECKSUMS.json; never apply eol conversion.
analysis/online_models/** -text
# The ablation baselines pin the LF bytes of their config.toml in CHECKSUMS.json.
analysis/ablation/evidence/**/config.toml text eol=lf
# v7 fast-verify package pins sha256 of train.csv, requirements.txt and policy files
# in runs/explore_v7_s7/run_config.json; checkouts must not rewrite line endings so
# `explore_v7.py audit` stays green on every teammate's machine.
analysis/online_v7_fast/** -text
