{
  "package": "SDM374_backup_models_v1",
  "purpose": "四个可直接预测的代理模型（不含 A1），加载即预测，无需重训",
  "models": [
    "gp-ard",
    "tail5opt",
    "hp_wlearn",
    "blend_xgb_w20x3"
  ],
  "excluded": {
    "A1_linear_trend_gp": "趋势项无界、属于参数假设，只能生成待实测候选，不作为可交付预测模型"
  },
  "feature_contract": {
    "n_features": 21,
    "order": [
      "b1_cost",
      "b1_carbon",
      "b1_peak",
      "b1_discomfort",
      "b1_degradation",
      "b1_ramping",
      "b1_resilience",
      "b2_cost",
      "b2_carbon",
      "b2_peak",
      "b2_discomfort",
      "b2_degradation",
      "b2_ramping",
      "b2_resilience",
      "b3_cost",
      "b3_carbon",
      "b3_peak",
      "b3_discomfort",
      "b3_degradation",
      "b3_ramping",
      "b3_resilience"
    ],
    "readable": "建筑1→建筑3；每栋 cost→carbon→peak→discomfort→degradation→ramping→resilience"
  },
  "target": "ramping",
  "protocol": {
    "oof": "sdm374.same8.splits.2x5x3.frozen.v1",
    "scoring": "sdm374.surrogate.tolerance.v3.2"
  },
  "external_dependencies": {
